    ],
    "sideBarForegroundRelay": "Indirectly through the agy.foreground alias."
  },
  "modernSemanticModel": {
    "appliesWhen": "Host editor theme mode, ordinary desktop text composer; standalone App glass styles are not enabled.",
    "B": "sideBar.background (bridge fallback: editor.background, then #1e1e1e)",
    "F": "sideBar.foreground (bridge fallback: editor.foreground, then #cccccc)",
    "mixSpace": "srgb",
    "contrast": {
      "defaultInternalValue": 1,
      "independentOfPrismContrastSetting": true,
      "1": {
        "secondaryDarkForeground": 0.12,
        "secondaryLightForeground": 0.06,
        "mutedForeground": 0.025,
        "cardDarkForeground": 0.05,
        "cardLightBackground": 0.7,
        "cardBorderDarkForeground": 0.05,
        "cardBorderLightForeground": 0.075,
        "genericBorderDarkAlpha": 0.05,
        "genericBorderLightAlpha": 0.075
      },
      "2": {
        "secondaryDarkForeground": 0.14,
        "secondaryLightForeground": 0.08,
        "mutedForeground": 0.04,
        "cardDarkForeground": 0.065,
        "cardLightBackground": 0.7,
        "cardBorderDarkForeground": 0.1,
        "cardBorderLightForeground": 0.12,
        "genericBorderDarkAlpha": 0.1,
        "genericBorderLightAlpha": 0.12
      }
    },
    "formulas": {
      "background": "B",
      "content": "B",
      "foreground": "F",
      "primary": "button.background",
      "primaryForeground": "button.foreground",
      "link": "textLink.foreground, with client fallback",
      "secondary": "mix(F, B, mode-specific secondaryForeground factor)",
      "secondaryForeground": "mix(F, B, 0.75)",
      "muted": "mix(F, B, mutedForeground factor)",
      "mutedForeground": "mix(F, B, 0.50)",
      "genericPlaceholder": "mix(F, B, 0.30); NOT composer placeholder",
      "sidebar": "mix(F, B, mutedForeground factor)",
      "sidebarSecondary": "mix(F, sidebar, mode-specific secondaryForeground factor)",
      "sidebarMuted": "mix(F, sidebar, mutedForeground factor)",
      "cardDark": "mix(F, B, cardDarkForeground factor)",
      "cardLight": "mix(B, #ffffff, 0.70)",
      "cardBorder": "mix(F, card, mode-specific cardBorderForeground factor)",
      "genericBorderDark": "rgba(255,255,255, genericBorderDarkAlpha)",
      "genericBorderLight": "rgba(0,0,0, genericBorderLightAlpha)",
      "composerPlaceholder": "foreground at opacity 0.60 over card; for opaque inputs, mix(F, card, 0.60)",
      "headerIcon": "secondaryForeground",
      "headerIconHover": "F on secondary",
      "welcomeTitle": "F on B",
      "shell": "background",
      "glass": "card",
      "glassBorder": "genericBorder"
    },
    "mixDefinition": "mix(X,Y,p) means CSS color-mix(in srgb, X p*100%, Y). For alpha colors preserve CSS premultiplied-alpha semantics."
  },
  "settingsScope": {
    "obsidianPrism.sidebarSurface": {
      "values": [
        "layered",
