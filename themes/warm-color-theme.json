  "tokenColors": [
    {
      "name": "Default text",
      "settings": {
        "foreground": "#F2EFE9",
        "background": "#141413"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A39E93",
        "fontStyle": ""
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#E2B354",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#E59377",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
      "settings": {
        "foreground": "#CEC8BC",
        "fontStyle": ""
      }
    },
    {
      "name": "Language constants and booleans",
      "scope": [
        "constant.language",
        "support.constant",
        "variable.language"
      ],
      "settings": {
        "foreground": "#E59377"
      }
    },
