  "tokenColors": [
    {
      "name": "Default text",
      "settings": {
        "foreground": "#F2F2F5",
        "background": "#0E0E11"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8A8A98",
        "fontStyle": ""
      }
    },
    {
      "name": "Documentation tags",
      "scope": [
        "storage.type.class.jsdoc",
        "entity.name.type.instance.jsdoc",
        "keyword.other.documentation"
      ],
      "settings": {
        "foreground": "#E2B354",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other"
      ],
      "settings": {
        "foreground": "#A58AF8",
        "fontStyle": ""
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator",
        "punctuation.accessor"
      ],
