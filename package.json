{
  "name": "obsidian-prism-vscode-theme",
  "displayName": "Obsidian Prism Theme",
  "description": "Prism themes for Antigravity IDE and VS Code, with bilingual settings, reversible controls and optional styling for the actual Antigravity chat sidebar.",
  "version": "0.3.0",
  "publisher": "bahayonghang",
  "license": "GPL-3.0-only",
  "author": "bahayonghang",
  "engines": {
    "vscode": "^1.96.0",
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bahayonghang/obsidian-prism-vscode-theme.git"
  },
  "bugs": {
    "url": "https://github.com/bahayonghang/obsidian-prism-vscode-theme/issues"
  },
  "homepage": "https://github.com/bahayonghang/obsidian-prism-vscode-theme#readme",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "obsidian",
    "prism",
    "dark",
    "light",
    "warm",
    "theme",
    "antigravity",
    "chat",
    "sidebar"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0E0E11",
    "theme": "dark"
  },
  "main": "./out/desktop.js",
  "browser": "./dist/browser.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "obsidianPrism.openSettings",
        "title": "%command.openSettings%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.chooseLanguage",
        "title": "%command.chooseLanguage%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.chooseTheme",
        "title": "%command.chooseTheme%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.openNativeSettings",
        "title": "%command.openNativeSettings%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.showCompatibilityReport",
        "title": "%command.showCompatibilityReport%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.enableChatAppearance",
        "title": "%command.enableChatAppearance%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.updateChatAppearance",
        "title": "%command.updateChatAppearance%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.disableChatAppearance",
        "title": "%command.disableChatAppearance%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.applyTypography",
        "title": "%command.applyTypography%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.restoreTypography",
        "title": "%command.restoreTypography%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.applySystemAppearance",
        "title": "%command.applySystemAppearance%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.restoreSystemAppearance",
        "title": "%command.restoreSystemAppearance%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.exportSettings",
        "title": "%command.exportSettings%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.importSettings",
        "title": "%command.importSettings%",
        "category": "Obsidian Prism"
      },
      {
        "command": "obsidianPrism.resetCustomizations",
        "title": "%command.resetCustomizations%",
        "category": "Obsidian Prism"
      }
    ],
    "configuration": {
      "title": "Obsidian Prism",
      "properties": {
        "obsidianPrism.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "enumItemLabels": [
            "%setting.language.option.auto%",
            "%setting.language.option.zh-CN%",
            "%setting.language.option.en%"
          ],
          "default": "auto",
          "scope": "application",
          "order": 0,
          "markdownDescription": "%setting.language%"
        },
        "obsidianPrism.accent": {
          "type": "string",
          "enum": [
            "default",
            "cobalt",
            "iris",
            "amber",
            "mono",
            "custom"
          ],
          "enumItemLabels": [
            "%setting.accent.option.default%",
            "%setting.accent.option.cobalt%",
            "%setting.accent.option.iris%",
            "%setting.accent.option.amber%",
            "%setting.accent.option.mono%",
            "%setting.accent.option.custom%"
          ],
          "default": "default",
          "scope": "application",
          "order": 1,
          "markdownDescription": "%setting.accent%"
        },
        "obsidianPrism.customAccent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "default": "#A58AF8",
          "scope": "application",
          "order": 2,
          "markdownDescription": "%setting.customAccent%"
        },
        "obsidianPrism.contrast": {
          "type": "string",
          "enum": [
            "standard",
            "high"
          ],
          "enumItemLabels": [
            "%setting.contrast.option.standard%",
            "%setting.contrast.option.high%"
          ],
          "default": "standard",
          "scope": "application",
          "order": 3,
          "markdownDescription": "%setting.contrast%"
        },
        "obsidianPrism.sidebarSurface": {
          "type": "string",
          "enum": [
            "layered",
            "unified",
            "tinted"
          ],
          "enumItemLabels": [
            "%setting.sidebarSurface.option.layered%",
            "%setting.sidebarSurface.option.unified%",
            "%setting.sidebarSurface.option.tinted%"
          ],
          "default": "layered",
          "scope": "application",
          "order": 4,
          "markdownDescription": "%setting.sidebarSurface%"
        },
        "obsidianPrism.inputBorder": {
          "type": "string",
          "enum": [
            "subtle",
            "accent"
          ],
          "enumItemLabels": [
            "%setting.inputBorder.option.subtle%",
            "%setting.inputBorder.option.accent%"
          ],
          "default": "subtle",
          "scope": "application",
          "order": 5,
          "markdownDescription": "%setting.inputBorder%"
        },
        "obsidianPrism.chatBackground": {
          "type": "string",
          "enum": [
            "none",
            "aurora",
            "auroraTexture"
          ],
          "enumItemLabels": [
            "%setting.chatBackground.option.none%",
            "%setting.chatBackground.option.aurora%",
            "%setting.chatBackground.option.auroraTexture%"
          ],
          "default": "auroraTexture",
          "scope": "application",
          "order": 6,
          "markdownDescription": "%setting.chatBackground%"
        },
        "obsidianPrism.chatBackgroundIntensity": {
          "type": "number",
          "enum": [
            0,
            35,
            70,
            100
          ],
          "enumItemLabels": [
            "%setting.chatBackgroundIntensity.option.0%",
            "%setting.chatBackgroundIntensity.option.35%",
            "%setting.chatBackgroundIntensity.option.70%",
            "%setting.chatBackgroundIntensity.option.100%"
          ],
          "default": 70,
          "scope": "application",
          "order": 7,
          "markdownDescription": "%setting.chatBackgroundIntensity%"
        },
        "obsidianPrism.chatComposerStyle": {
          "type": "string",
          "enum": [
            "native",
            "prism"
          ],
          "enumItemLabels": [
            "%setting.chatComposerStyle.option.native%",
            "%setting.chatComposerStyle.option.prism%"
          ],
          "default": "prism",
          "scope": "application",
          "order": 8,
          "markdownDescription": "%setting.chatComposerStyle%"
        },
        "obsidianPrism.chatModelStyle": {
          "type": "string",
          "enum": [
            "native",
            "prism"
          ],
          "enumItemLabels": [
            "%setting.chatModelStyle.option.native%",
            "%setting.chatModelStyle.option.prism%"
          ],
          "default": "prism",
          "scope": "application",
          "order": 9,
          "markdownDescription": "%setting.chatModelStyle%"
        },
        "obsidianPrism.chatMotion": {
          "type": "string",
          "enum": [
            "off",
            "subtle"
          ],
          "enumItemLabels": [
            "%setting.chatMotion.option.off%",
            "%setting.chatMotion.option.subtle%"
          ],
          "default": "off",
          "scope": "application",
          "order": 10,
          "markdownDescription": "%setting.chatMotion%"
        },
        "obsidianPrism.italicComments": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 11,
          "markdownDescription": "%setting.italicComments%"
        },
        "obsidianPrism.boldKeywords": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "order": 12,
          "markdownDescription": "%setting.boldKeywords%"
        },
        "obsidianPrism.codeFont": {
          "type": "string",
          "enum": [
            "default",
            "jetbrains",
            "cascadia",
            "sfmono"
          ],
          "enumItemLabels": [
            "%setting.codeFont.option.default%",
            "%setting.codeFont.option.jetbrains%",
            "%setting.codeFont.option.cascadia%",
            "%setting.codeFont.option.sfmono%"
          ],
          "default": "default",
          "scope": "application",
          "order": 13,
          "markdownDescription": "%setting.codeFont%"
        },
        "obsidianPrism.ligatures": {
          "type": "string",
          "enum": [
            "inherit",
            "on",
            "off"
          ],
          "enumItemLabels": [
            "%setting.ligatures.option.inherit%",
            "%setting.ligatures.option.on%",
            "%setting.ligatures.option.off%"
          ],
          "default": "inherit",
          "scope": "application",
          "order": 14,
          "markdownDescription": "%setting.ligatures%"
        },
        "obsidianPrism.smoothCaret": {
          "type": "string",
          "enum": [
            "inherit",
            "on",
            "off"
          ],
          "enumItemLabels": [
            "%setting.smoothCaret.option.inherit%",
            "%setting.smoothCaret.option.on%",
            "%setting.smoothCaret.option.off%"
          ],
          "default": "inherit",
          "scope": "application",
          "order": 15,
          "markdownDescription": "%setting.smoothCaret%"
        },
        "obsidianPrism.smoothScrolling": {
          "type": "string",
          "enum": [
            "inherit",
            "on",
            "off"
          ],
          "enumItemLabels": [
            "%setting.smoothScrolling.option.inherit%",
            "%setting.smoothScrolling.option.on%",
            "%setting.smoothScrolling.option.off%"
          ],
          "default": "inherit",
          "scope": "application",
          "order": 16,
          "markdownDescription": "%setting.smoothScrolling%"
        },
        "obsidianPrism.cornerStyle": {
          "type": "string",
          "enum": [
            "sharp",
            "balanced",
            "soft"
          ],
          "enumItemLabels": [
            "%setting.cornerStyle.option.sharp%",
            "%setting.cornerStyle.option.balanced%",
            "%setting.cornerStyle.option.soft%"
          ],
          "default": "balanced",
          "scope": "application",
          "order": 17,
          "markdownDescription": "%setting.cornerStyle%"
        },
        "obsidianPrism.ambientIntensity": {
          "type": "number",
          "enum": [
            0,
            35,
            70,
            100
          ],
          "enumItemLabels": [
            "%setting.ambientIntensity.option.0%",
            "%setting.ambientIntensity.option.35%",
            "%setting.ambientIntensity.option.70%",
            "%setting.ambientIntensity.option.100%"
          ],
          "default": 70,
          "scope": "application",
          "order": 18,
          "markdownDescription": "%setting.ambientIntensity%"
        },
        "obsidianPrism.motion": {
          "type": "string",
          "enum": [
            "off",
            "subtle",
            "standard",
            "ultra"
          ],
          "enumItemLabels": [
            "%setting.motion.option.off%",
            "%setting.motion.option.subtle%",
            "%setting.motion.option.standard%",
            "%setting.motion.option.ultra%"
          ],
          "default": "standard",
          "scope": "application",
          "order": 19,
          "markdownDescription": "%setting.motion%"
        },
        "obsidianPrism.preferredDark": {
          "type": "string",
          "enum": [
            "obsidian",
            "warm"
          ],
          "enumItemLabels": [
            "%setting.preferredDark.option.obsidian%",
            "%setting.preferredDark.option.warm%"
          ],
          "default": "obsidian",
          "scope": "application",
          "order": 20,
          "markdownDescription": "%setting.preferredDark%"
        },
        "obsidianPrism.preferredLight": {
          "type": "string",
          "enum": [
            "crystal",
            "alabaster"
          ],
          "enumItemLabels": [
            "%setting.preferredLight.option.crystal%",
            "%setting.preferredLight.option.alabaster%"
          ],
          "default": "crystal",
          "scope": "application",
          "order": 21,
          "markdownDescription": "%setting.preferredLight%"
        }
      }
    },
    "themes": [
      {
        "id": "Obsidian Prism — Obsidian Dark",
        "label": "Obsidian Prism — Obsidian Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/obsidian-color-theme.json"
      },
      {
        "id": "Obsidian Prism — Warm Charcoal",
        "label": "Obsidian Prism — Warm Charcoal",
        "uiTheme": "vs-dark",
        "path": "./themes/warm-color-theme.json"
      },
      {
        "id": "Obsidian Prism — Daylight Crystal",
        "label": "Obsidian Prism — Daylight Crystal",
        "uiTheme": "vs",
        "path": "./themes/crystal-color-theme.json"
      },
      {
        "id": "Obsidian Prism — Warm Alabaster",
        "label": "Obsidian Prism — Warm Alabaster",
        "uiTheme": "vs",
        "path": "./themes/alabaster-color-theme.json"
      }
    ],
    "colors": [
      {
        "id": "obsidianPrism.themeMarker",
        "description": "%color.themeMarker%",
        "defaults": {
          "dark": "#00000000",
          "light": "#00000000",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "build": "npm run compile && node scripts/generate.cjs && node scripts/bundle.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.js",
    "test:host": "node scripts/test-host.cjs",
    "test:ui": "node scripts/test-ui.cjs",
    "test:chat-ui": "node scripts/test-chat-ui.cjs",
    "test:adapter-electron": "node scripts/test-adapter-electron.cjs",
    "vscode:prepublish": "npm run build",
    "package": "node scripts/package.cjs",
    "check:generated": "npm run build && git diff --exit-code -- themes package.json package.nls.json package.nls.zh-cn.json"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "playwright": "^1.56.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  }
}
